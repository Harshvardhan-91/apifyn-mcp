# Base URL of the APIfyn API (the Express server, not the Next.js site)
APIFYN_API_URL=http://localhost:5000

# Local (stdio) mode only: your personal key from APIfyn → Settings → API keys.
# In hosted (--http) mode this is ignored; every client sends its own key.
APIFYN_API_KEY=apf_your_key_here

# Hosted (--http) mode only
PORT=3333
